# Copiar a .env y rellenar. El archivo .env no se versiona.

# Clave de sesión de Flask. Obligatoria; generar un valor aleatorio local de al menos 32 caracteres.
SECRET_KEY=

# Entorno: development | testing | production
FLASK_ENV=development

# Conexión a la base de datos. Por defecto, SQLite en instance/marketflow.db
# DATABASE_URL=sqlite:///marketflow.db
